generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String       @id @default(uuid())
  username      String       @unique
  passwordHash  String
  apiKey        String?      @unique @default(uuid())
  isAdmin       Boolean      @default(false)
  isReseller    Boolean      @default(false)
  role          String       @default("user") // "admin", "reseller", "user"
  resellerId    String?
  reseller      User?        @relation("ResellerClients", fields: [resellerId], references: [id], onDelete: Cascade)
  clients       User[]       @relation("ResellerClients")
  maxInstances  Int          @default(3)
  messageLimit  Int          @default(1000)
  permissions   String       @default("instances,broadcast,filter,groups,reports,docs")
  expiresAt     DateTime?
  instances     Instance[]
  messageLogs   MessageLog[]
  filterBatches FilterBatch[]
  customDomain  String?      @unique
  domainStatus  String       @default("none") // "none", "pending", "verified", "active", "error"
  domainSslActive Boolean    @default(false)
  brandName     String?
  brandLogoUrl  String?
  brandThemeColor String?
  messagesSentThisMonth Int @default(0)
  lastMessageMonth      String @default("")
  dailyUsageStats DailyUsageStat[]
  createdAt     DateTime     @default(now())
}

model DailyUsageStat {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           String   // Format: "YYYY-MM-DD" (Indexed for instant historical date filtering)
  totalCount     Int      @default(0)
  deliveredCount Int      @default(0)
  failedCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
}

model Instance {
  id             String       @id // This is the instance_id
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  status         String       @default("disconnected") // connected, disconnected
  phoneNumber    String?
  webhookUrl     String?
  webhookEnabled Boolean      @default(false)
  createdAt      DateTime     @default(now())
  messageLogs    MessageLog[]
}

model MessageLog {
  id         String   @id @default(uuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toNumber   String
  message    String?
  status     String   // "sent", "failed"
  createdAt  DateTime @default(now())
}

model FilterBatch {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  instanceId   String
  name         String       @default("Batch Filter")
  totalCount   Int          @default(0)
  validCount   Int          @default(0)
  invalidCount Int          @default(0)
  status       String       @default("completed") // "processing", "completed"
  items        FilterItem[]
  createdAt    DateTime     @default(now())
}

model FilterItem {
  id        String      @id @default(uuid())
  batchId   String
  batch     FilterBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  number    String
  exists    Boolean     @default(false)
  jid       String?
  createdAt DateTime    @default(now())
}

